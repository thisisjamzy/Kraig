{
  "name": "dreda",
  "private": true,
  "description": "Repo root \u2014 npm workspaces linking the Next.js app, Cloud Functions, and the shared budget-recurrence module they both need. See PRD-FIREBASE.md.",
  "workspaces": [
    "app",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "emulators": "firebase emulators:start",
    "migrate": "tsx scripts/migrate-notion-to-firestore.ts",
    "seed": "tsx scripts/seed-dummy-data.ts",
    "unseed": "tsx scripts/unseed-dummy-data.ts",
    "seed:goals-debt": "tsx scripts/seed-goals-debt-dummy-data.ts",
    "unseed:goals-debt": "tsx scripts/unseed-goals-debt-dummy-data.ts",
    "phone:check": "node scripts/phone-line.mjs",
    "phone:approve": "node scripts/phone-line.mjs --approve",
    "test:rules": "firebase emulators:exec --only firestore --project dreda-rules-test \"tsx --test test/firestore-rules.test.ts\"",
    "test:functions": "npm run build --prefix functions && firebase emulators:exec --only functions,firestore,auth --project dreda-emu-test \"node --test functions/lib/integration/*.test.js\"",
    "test:budget": "tsx --test test/monthBudget.test.ts test/budgetFlow.test.ts",
    "test:calendar": "tsx --test test/dayLayout.test.ts",
    "test:calendar-sync": "tsx --test test/calendarBridge.test.ts test/calendarSync.test.ts",
    "test:insights": "tsx --test test/financeInsights.test.ts test/keyCharts.test.ts",
    "test:plans": "tsx --test test/plans.test.ts",
    "test:nav": "tsx --test test/navHistory.test.ts",
    "migrate:budgets-v2": "tsx scripts/migrate-budgets-v2.ts",
    "test:plan": "tsx --test test/planForecast.test.ts",
    "test:time": "tsx --test test/timePages.test.ts",
    "test:home": "tsx --test test/homeDebt.test.ts",
    "test:debt": "tsx --test test/debtWalletEffect.test.ts test/debtPages.test.ts",
    "test:notify": "tsx --test test/notifications.test.ts",
    "test:engine": "tsx --test test/planEngine.test.ts",
    "test:import": "tsx --test test/importTasks.test.ts",
    "test:occurrences": "tsx --test test/occurrences.test.ts test/debtSchedule.test.ts test/dismissals.test.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.28.2",
    "tsx": "^4.7.0"
  }
}
